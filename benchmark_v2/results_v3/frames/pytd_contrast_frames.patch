From 83a4806f7164977c9dfe170437d13466115161c8 Mon Sep 17 00:00:00 2001
From: Brian Haas <brianjohnhaas@gmail.com>
Date: Sat, 24 Oct 2026 23:46:45 -0400
Subject: [PATCH] Experimental --contrast-frames {forward,all}: contrast
 against all five other frames in ORF acceptance

Applies to target and decoy ORFs (eligibility and q-values); start refinement and mu unchanged.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 pytransdecoder/cli.py     |  5 +++++
 pytransdecoder/predict.py | 30 +++++++++++++++++++++++-------
 2 files changed, 28 insertions(+), 7 deletions(-)

diff --git a/pytransdecoder/cli.py b/pytransdecoder/cli.py
index 8315fce..96b0716 100644
--- a/pytransdecoder/cli.py
+++ b/pytransdecoder/cli.py
@@ -106,6 +106,9 @@ def _add_selection_args(parser):
                              "(~20 Mb of decoy sequence, at most 50)")
     parser.add_argument('--decoy-seed', type=int, default=DEFAULT_DECOY_SEED, dest='decoy_seed',
                         help="Seed of the decoy shuffles (default: %(default)s)")
+    parser.add_argument('--contrast-frames', choices=['forward', 'all'], default='forward', dest='contrast_frames',
+                        help="Experimental: frames the in-frame score must beat in ORF acceptance: the two "
+                             "shifted forward frames (default) or all five other frames")
     from .core.presets import bundled_presets
     parser.add_argument('--preset', default=None,
                         help="Use a preset's coding model, start model and q-value thresholds instead of "
@@ -318,6 +321,7 @@ def predict_cmd(args):
             decoy_shuffles=args.decoy_shuffles,
             decoy_seed=args.decoy_seed,
             preset=args.preset,
+            contrast_frames=args.contrast_frames,
         )
         predictor.run()
     except Exception as e:
@@ -590,6 +594,7 @@ def pipeline_cmd(args):
             decoy_shuffles=args.decoy_shuffles,
             decoy_seed=args.decoy_seed,
             preset=args.preset,
+            contrast_frames=args.contrast_frames,
         )
         predictor.run()
     except Exception as e:
diff --git a/pytransdecoder/predict.py b/pytransdecoder/predict.py
