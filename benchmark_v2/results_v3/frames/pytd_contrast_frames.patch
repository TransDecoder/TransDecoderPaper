     ):
         """
         Initialize TransDecoder.Predict
@@ -128,6 +129,11 @@ class TransDecoderPredict:
         self.decoy_q = decoy_q
         self.decoy_shuffles = decoy_shuffles
         self.decoy_seed = decoy_seed
+        # experimental: frames the in-frame score is contrasted with in ORF acceptance (targets and decoys);
+        # "forward" = the two shifted forward frames (release), "all" = all five other frames
+        if contrast_frames not in ("forward", "all"):
+            raise ValueError(f"contrast_frames must be 'forward' or 'all', not {contrast_frames!r}")
+        self.contrast_frames = contrast_frames
         self.preset = None
         if preset:
             from pytransdecoder.core.presets import Preset, resolve
@@ -692,7 +698,7 @@ class TransDecoderPredict:
                 scores = cds_scores.get(orf_id, [0.0] * 6)
                 
                 # Apply selection criteria
-                frame_contrast = scores[0] - max(scores[1], scores[2])
+                frame_contrast = self._acceptance_contrast(scores)
                 meets_criteria = (homology_count > 0 or orf_length >= min_length_auto_accept or
                                   (scores[0] > 0 and frame_contrast > 0 and
                                    decoy_q.get(orf_id, 1.0) <= self.decoy_q))
@@ -858,7 +864,7 @@ class TransDecoderPredict:
