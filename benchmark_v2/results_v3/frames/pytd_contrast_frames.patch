+            c = self._acceptance_contrast(sc)
             if sc[0] > 0 and c > 0 and orf_id in info:
                 orf_type, tid = info[orf_id]
                 targets[orf_id] = (decoys.stratum(lengths[orf_id], tx_len.get(tid, 0), orf_type == 'complete',
@@ -915,10 +921,14 @@ class TransDecoderPredict:
         n_shuf = self.decoy_shuffles or max(1, min(DECOY_MAX_SHUFFLES, -(-DECOY_TARGET_NT // max(total_nt, 1))))
 
         def contrast(seq):
-            s0 = round(self._score_cds_via_markov(seq, 5, hex_scores), 2)
-            s1 = round(self._score_cds_via_markov(seq[1:], 5, hex_scores), 2)
-            s2 = round(self._score_cds_via_markov(seq[2:], 5, hex_scores), 2)
-            return s0, s0 - max(s1, s2)
+            sc = [round(self._score_cds_via_markov(seq, 5, hex_scores), 2),
+                  round(self._score_cds_via_markov(seq[1:], 5, hex_scores), 2),
+                  round(self._score_cds_via_markov(seq[2:], 5, hex_scores), 2)]
+            if self.contrast_frames == "all":
+                from pytransdecoder.core.sequence import reverse_complement
+                rc = reverse_complement(seq)
+                sc += [round(self._score_cds_via_markov(rc[i:], 5, hex_scores), 2) for i in range(3)]
+            return sc[0], self._acceptance_contrast(sc)
 
         # targets: eligible LongOrfs candidates
         info = {}
@@ -933,7 +943,7 @@ class TransDecoderPredict:
                 lengths[r.id] = len(r.seq) // 3
         targets = {}
         for orf_id, sc in cds_scores.items():
-            c = sc[0] - max(sc[1], sc[2])
+            c = self._acceptance_contrast(sc)
             if sc[0] > 0 and c > 0 and orf_id in info:
                 orf_type, tid = info[orf_id]
                 targets[orf_id] = (decoys.stratum(lengths[orf_id], len(transcripts.get(tid, '')),
@@ -1152,6 +1162,12 @@ class TransDecoderPredict:
                     scores[parts[0]] = float(parts[3])
         return scores
 
+    def _acceptance_contrast(self, sc) -> float:
+        """Frame contrast used for ORF acceptance: in-frame score minus the best competing frame."""
+        if self.contrast_frames == "all":
+            return sc[0] - max(sc[1:6])
+        return sc[0] - max(sc[1], sc[2])
